<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yohuke.DanmuPanel.Views.BrowserCookieLoginWindow"
        xmlns:vm="using:Yohuke.DanmuPanel.ViewModels" x:DataType="vm:BrowserCookieLoginViewModel" Title="{Binding TitleText}"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        >
    <Grid Classes="rootSurface"
          RowDefinitions="Auto,*">
        <Border Classes="browserLoginToolbar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                  ColumnSpacing="8">
	                <Button ToolTip.Tip="{Loc Key=UI.BrowserCookieLoginWindow.Back}"
	                        Classes="iconButton"
	                        Command="{Binding BackCommand}">
	                    <LucideIcon Kind="CircleArrowLeft"/>
	                </Button>
	                <Button Grid.Column="1"
	                        ToolTip.Tip="{Loc Key=UI.BrowserCookieLoginWindow.Forward}"
	                        Classes="iconButton"
	                        Command="{Binding ForwardCommand}">
	                    <LucideIcon Kind="CircleArrowRight"/>
	                </Button>
	                <Button Grid.Column="2"
	                        ToolTip.Tip="{Loc Key=UI.BrowserCookieLoginWindow.Refresh}"
	                        Classes="iconButton"
	                        Command="{Binding RefreshCommand}">
	                    <LucideIcon Kind="RefreshCw"/>
	                </Button>
                <StackPanel Grid.Column="3"
                            Spacing="2"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Text="{Binding TitleText}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}"
                               Classes="muted"/>
                </StackPanel>
	                <Button Grid.Column="4"
	                        Content="{Loc Key=UI.BrowserCookieLoginWindow.Cancel}"
	                        Command="{Binding CancelCommand}"/>
	                <Button Grid.Column="5"
	                        x:Name="CaptureButton" IsEnabled="{Binding !IsCapturing}"
	                        Classes="primaryButton"
	                        Command="{Binding CaptureCommand}">
	                    <StackPanel Orientation="Horizontal"
	                                Spacing="6">
	                        <LucideIcon Kind="Cookie"/>
	                        <TextBlock Text="{Loc Key=UI.BrowserCookieLoginWindow.CaptureCookies}"/>
	                    </StackPanel>
	                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="browserLoginSurface">
            <Border x:Name="WebViewHost"
                    Classes="browserLoginPlaceholder">
                <TextBlock x:Name="WebViewPlaceholderText"
                           Text="{Binding PlaceholderText}" IsVisible="{Binding IsPlaceholderVisible}"
                           Classes="muted"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Border>
    </Grid>
</Window>
