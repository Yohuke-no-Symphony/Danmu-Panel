<DockPanel xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:components="using:Yohuke.DanmuPanel.Views.Components"
           x:Class="Yohuke.DanmuPanel.Views.Components.WindowFrameSurface"
           x:Name="Root" x:DataType="components:WindowFrameSurface"
           LastChildFill="True">
    <components:WindowTitleBar x:Name="SharedTitleBar" DockPanel.Dock="Top"
                              RightContent="{Binding RightContent, ElementName=Root}" />
    <ContentPresenter Content="{Binding BodyContent, ElementName=Root}"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
</DockPanel>
