<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:Yohuke.DanmuPanel.Views.Components"
             xmlns:vm="using:Yohuke.DanmuPanel.ViewModels.Settings"
             xmlns:settings="using:Yohuke.DanmuPanel.Views.Settings"
             x:Class="Yohuke.DanmuPanel.Views.Settings.SpecialAttentionSearchSurface"
             x:DataType="vm:SpecialAttentionEditorViewModel">
    <components:SearchAndManualDialogSurface x:Name="LookupDialog">
        <components:SearchAndManualDialogSurface.HeaderContent>
            <StackPanel Spacing="6">
                <TextBlock Text="{Loc Key=SpecialAttention.FindUsers}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Loc Key=SpecialAttention.SearchHelp}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
        </components:SearchAndManualDialogSurface.HeaderContent>
        <components:SearchAndManualDialogSurface.SearchContent>
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SpecialAttentionSearchInput" Text="{Binding SearchText}"
                             Watermark="{Loc Key=SpecialAttention.SearchHint}" KeyDown="Search_OnKeyDown" />
                    <Button x:Name="SpecialAttentionSearchButton" Grid.Column="1"
                            Content="{Loc Key=Panel.Search}" Command="{Binding SearchCommand}" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="6">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" Height="2" />
                    <TextBlock Text="{Binding SearchStatus}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <ItemsControl x:Name="SpecialAttentionSearchResults" ItemsSource="{Binding SearchResultRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpecialAttentionUserRowViewModel">
                                    <settings:SpecialAttentionUserRowSurface />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="SpecialAttentionLoadMoreButton" Content="{Loc Key=Workspace.LoadMore}"
                                Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMoreResults}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </components:SearchAndManualDialogSurface.SearchContent>
        <components:SearchAndManualDialogSurface.ManualContent>
            <StackPanel Spacing="12">
                <TextBlock Text="{Loc Key=SpecialAttention.ManualHelp}" Classes="muted" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,2*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SpecialAttentionManualUid" Text="{Binding ManualUid}" Watermark="UID" />
                    <TextBox x:Name="SpecialAttentionManualName" Grid.Column="1"
                             Text="{Binding ManualDisplayName}" Watermark="{Loc Key=SpecialAttention.DisplayNameHint}" />
                    <Button x:Name="AddSpecialAttentionManualUserButton" Grid.Column="2"
                            Content="{Loc Key=SpecialAttention.AddUser}" Command="{Binding AddManualUserCommand}" />
                </Grid>
            </StackPanel>
        </components:SearchAndManualDialogSurface.ManualContent>
        <components:SearchAndManualDialogSurface.StatusContent>
            <TextBlock Text="{Binding EditStatus}" Foreground="{DynamicResource AppErrorBrush}" TextWrapping="Wrap" />
        </components:SearchAndManualDialogSurface.StatusContent>
        <components:SearchAndManualDialogSurface.FooterContent>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Loc Key=SpecialAttention.SelectedUsers}" Classes="muted" />
                    <TextBlock Text="{Binding Users.Count}" Classes="muted" />
                </StackPanel>
                <Button x:Name="CloseSpecialAttentionSearchButton" Grid.Column="1"
                        Content="{Loc Key=SpecialAttention.Done}" Classes="primaryButton" />
            </Grid>
        </components:SearchAndManualDialogSurface.FooterContent>
    </components:SearchAndManualDialogSurface>
</UserControl>
