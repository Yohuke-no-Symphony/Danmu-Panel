<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuPanel.Views.Settings.AccountSettingsRowSurface"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Ellipse.accountValidity">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="Ellipse.accountValidity.valid">
            <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.accountValidity.invalid">
            <Setter Property="Fill" Value="{DynamicResource AppErrorBrush}" />
        </Style>
        <Style Selector="Ellipse.accountValidity.uncertain">
            <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}" />
        </Style>
    </UserControl.Styles>
    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid x:Name="AccountRowLayout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
              ColumnSpacing="8" RowSpacing="4">
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="220" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="AccountValidity" Classes="accountValidity" />
                <TextBox x:Name="AccountNameEditor" Grid.Column="1" MinWidth="0" MaxWidth="220"
                         Height="{StaticResource WorkbenchControlHeight}" VerticalAlignment="Center"
                         Watermark="{Loc Key=Panel.Name}" AutomationProperties.Name="{Loc Key=Panel.Name}" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="AccountBrowserLogin" Classes="iconButton"
                        ToolTip.Tip="{Loc Key=Panel.BrowserLogin}" AutomationProperties.Name="{Loc Key=Panel.BrowserLogin}">
                    <LucideIcon Kind="LogIn" />
                </Button>
                <RadioButton x:Name="DefaultAccountToggle" Classes="iconButton"
                             Theme="{StaticResource {x:Type ToggleButton}}" GroupName="DefaultAccount"
                             ToolTip.Tip="{Loc Key=Panel.DefaultAccount}" AutomationProperties.Name="{Loc Key=Panel.DefaultAccount}">
                    <LucideIcon Kind="BadgeCheck" />
                </RadioButton>
                <Button x:Name="AccountValidate" Classes="iconButton"
                        ToolTip.Tip="{Loc Key=Panel.ValidateAccount}" AutomationProperties.Name="{Loc Key=Panel.ValidateAccount}">
                    <LucideIcon Kind="RefreshCw" />
                </Button>
                <Button x:Name="AccountDelete" Classes="iconButton"
                        ToolTip.Tip="{Loc Key=Panel.Delete}" AutomationProperties.Name="{Loc Key=Panel.Delete}">
                    <LucideIcon Kind="Trash2" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="AccountProfile" Grid.Row="1" Grid.ColumnSpan="2" Margin="18,0,0,0"
                       Classes="muted" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
