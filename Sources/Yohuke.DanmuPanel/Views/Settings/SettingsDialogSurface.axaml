<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuPanel.Views.Settings.SettingsDialogSurface"
             x:CompileBindings="False">
    <Border Background="{DynamicResource AppCardBrush}" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="230,*">
            <Border Grid.ColumnSpan="2" Classes="settingsDialogHeader">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Loc Key=Settings.Title}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="SectionDescription" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource AppErrorBrush}"
                                   TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                    <Button x:Name="SaveSettingsButton" Grid.Column="1" Classes="primaryButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="Save" />
                            <TextBlock Text="{Loc Key=Settings.Save}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1" Classes="settingsDialogSidebar">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SectionNavigation" Spacing="8" />
                </ScrollViewer>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Classes="settingsDialogContent">
                <ContentControl x:Name="SectionContent" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Border>
</UserControl>
