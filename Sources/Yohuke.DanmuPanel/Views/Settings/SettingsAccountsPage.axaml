<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Yohuke.DanmuPanel.Views.Settings"
             xmlns:vm="using:Yohuke.DanmuPanel.ViewModels.Settings"
             x:Class="Yohuke.DanmuPanel.Views.Settings.SettingsAccountsPage"
             x:Name="Root"
             x:DataType="vm:SettingsDialogViewModel"
             x:CompileBindings="True">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ContentPresenter Content="{Binding Editor, ElementName=Root}" HorizontalContentAlignment="Stretch"/>
    </ScrollViewer>
</UserControl>
