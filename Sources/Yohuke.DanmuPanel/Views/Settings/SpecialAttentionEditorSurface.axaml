<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuPanel.Views.Settings.SpecialAttentionEditorSurface"
             x:CompileBindings="False">
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="180,*" ColumnSpacing="14">
            <TextBlock Text="{Loc Key=SpecialAttention.Color}" VerticalAlignment="Center" />
            <ContentControl x:Name="SpecialAttentionColorInputHost" Grid.Column="1" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Loc Key=SpecialAttention.SelectedUsers}" Classes="sectionTitle" />
                <TextBlock Text="{Binding Users.Count}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="OpenSpecialAttentionSearchButton" Grid.Column="1"
                    Content="{Loc Key=SpecialAttention.OpenSearch}" />
        </Grid>
        <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SpecialAttentionUsers" ItemsSource="{Binding Users}" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
