<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yohuke.DanmuPanel.Views.Settings.AccountSettingsSurface"
             xmlns:vm="using:Yohuke.DanmuPanel.ViewModels.Settings"
             xmlns:settings="using:Yohuke.DanmuPanel.Views.Settings"
             x:DataType="vm:AccountSettingsViewModel">
    <UserControl.ContextMenu>
        <ContextMenu><MenuItem Header="{Loc Key=Panel.AddAccountManually}" Command="{Binding AddManuallyCommand}"><MenuItem.Icon><LucideIcon Kind="UserPlus" /></MenuItem.Icon></MenuItem></ContextMenu>
    </UserControl.ContextMenu>
    <StackPanel Spacing="18">
        <Border Classes="panel" Padding="14">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Loc Key=Settings.Accounts}" Classes="sectionTitle" VerticalAlignment="Center" />
                    <Button x:Name="BrowserAddAccount" Command="{Binding AddAccountCommand}" Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <LucideIcon Kind="UserPlus" />
                            <TextBlock Text="{Loc Key=Panel.AddAccount}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ItemsControl x:Name="AccountRows" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate><DataTemplate DataType="vm:AccountSettingsRowViewModel"><settings:AccountSettingsRow /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="AccountOperationStatus" Text="{Binding Status}" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppErrorBrush}" IsVisible="{Binding HasStatus}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
