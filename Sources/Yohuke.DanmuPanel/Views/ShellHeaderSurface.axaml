<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="using:Yohuke.DanmuPanel.Views"
      x:Class="Yohuke.DanmuPanel.Views.ShellHeaderSurface"
      x:Name="Root" x:DataType="views:ShellHeaderSurface"
      ColumnDefinitions="Auto,Auto,*" Margin="12,0,8,0">
    <TextBlock Text="Danmu Panel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
    <Menu x:Name="WindowMenu" Grid.Column="1" Classes="workbenchMenu" VerticalAlignment="Center" />
    <ContentPresenter Grid.Column="2" Content="{Binding RoomToolbar, ElementName=Root}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
</Grid>
