<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:updates="using:Yohuke.DanmuPanel.ViewModels.Updates"
             x:Class="Yohuke.DanmuPanel.Views.Updates.AppUpdateSurface"
             x:DataType="updates:AppUpdateViewModel">
    <Border Background="{DynamicResource AppCardBrush}" Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
            <TextBlock Text="{Binding Message}" FontSize="20" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsChecking}" Height="4" />
            <StackPanel Grid.Row="2" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Loc Key=Updates.CurrentVersion}" Classes="muted" />
                    <TextBlock Text="{Binding CurrentVersion}" />
                </StackPanel>
                <TextBlock Text="{Binding AvailableVersion}" IsVisible="{Binding HasUpdate}"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Loc Key=Updates.ReleaseHint}" IsVisible="{Binding HasUpdate}"
                           Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                    CornerRadius="6" IsVisible="{Binding HasReleaseNotes}">
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Margin="12" />
                </ScrollViewer>
            </Border>
            <TextBlock Grid.Row="4" Text="{Loc Key=Updates.BrowserFailed}" IsVisible="{Binding HasBrowserError}"
                       Foreground="{DynamicResource AppErrorBrush}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Name="RetryUpdateButton" Content="{Loc Key=Updates.Retry}"
                        Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                <Button Name="CloseUpdateButton" Content="{Loc Key=Updates.Close}" />
                <Button Name="OpenReleaseButton" Content="{Loc Key=Updates.OpenRelease}"
                        Command="{Binding OpenReleaseCommand}" IsVisible="{Binding HasUpdate}"
                        Classes="primaryButton" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
