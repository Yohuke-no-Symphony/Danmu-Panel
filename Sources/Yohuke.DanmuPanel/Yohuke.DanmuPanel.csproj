<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>Yohuke.DanmuPanel</RootNamespace>
        <Company>Yohuke no Symphony</Company>
        <Product>Yohuke Danmu Panel</Product>
        <AssemblyVersion>0.0.1</AssemblyVersion>
        <FileVersion>0.0.1</FileVersion>
        <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Apis\Models\" />
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.13" />
        <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.0" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.13" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
        <PackageReference Include="Dock.Avalonia" Version="11.3.12.1" />
        <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="11.3.12.1" />
        <PackageReference Include="Dock.Model.Mvvm" Version="11.3.12.1" />
        <PackageReference Include="Lucide.Avalonia" Version="0.2.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Apis/Protocols/Bilibili/*.proto" ProtoRoot="Apis/Protocols/Bilibili" GrpcServices="None" Access="Internal" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Yohuke.DanmuPanel.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Update="I18n/Languages/*.json">
            <TargetPath>i18n/%(Filename)%(Extension)</TargetPath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </None>
        <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="ThirdParty/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
        <PackageReference Include="csharp-pinyin" Version="1.0.1" />
    </ItemGroup>
</Project>
